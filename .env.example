# Copy to .env.local and fill in. .env.local is gitignored: never commit real keys.

# ---------- Mode ----------
# Unset: self-hosted (no plans, everything unlocked). "cloud": plans, limits, billing, /pricing.
LOCALXPO_MODE=cloud

# Public URL (copy-paste CLI commands, Stripe return URLs). Detected from the request when unset.
# NEXT_PUBLIC_APP_URL=https://cloud.example.com

# ---------- Database ----------
# Unset: embedded Postgres in ./data/pglite. Set for Neon / any Postgres (use the pooled URL on Neon).
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# DATABASE_POOL_SIZE=10

# Key that encrypts store credentials. Generated into data/.secret when unset; set it in production and back it up.
# LOCALXPO_SECRET=

# ---------- Stripe (billing) ----------
# Dashboard → Developers → API keys. Test keys start with sk_test_ / pk_test_.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret (whsec_…): from `stripe listen` while developing, or added by
# `pnpm stripe:setup --webhook-url https://<domain>/api/stripe/webhook` in production.
STRIPE_WEBHOOK_SECRET=

# Optional: a specific Customer Portal configuration (bpc_…). By default the one created by `pnpm stripe:setup` is used.
# STRIPE_PORTAL_CONFIGURATION=

# ---------- Landing page ----------
# When src/app/(landing) is present, visitors without a session see it at /. Set 0 to show the sign-in form instead.
# LOCALXPO_LANDING=0
